<?xml version="1.0" encoding="utf-8"?>
<!-- VancoTrack launcher icon foreground -->
<!-- A stylised pill/capsule overlaid with a heart-rate pulse line -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Teal circle backdrop (safe zone 72dp centred on 108dp canvas) -->
    <path
        android:fillColor="#0C9B8A"
        android:pathData="M54,18 A36,36 0 1,1 53.9999,18 Z" />

    <!-- White pill / capsule shape centred -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M40,47 L40,61
          A7,7 0 0,0 47,68
          L61,68
          A7,7 0 0,0 68,61
          L68,47
          A7,7 0 0,0 61,40
          L47,40
          A7,7 0 0,0 40,47 Z" />

    <!-- Teal diagonal divider across pill -->
    <path
        android:fillColor="#0C9B8A"
        android:pathData="M40,52 L56,40 L68,40 L68,44 L52,56 L40,56 Z" />

    <!-- Teal pulse / ECG line across bottom half of icon -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M26,75 L36,75 L40,68 L44,82 L48,70 L52,75 L82,75" />

</vector>
